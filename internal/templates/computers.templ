package templates

templ Computers(rows []ComputerRow) {
	<div class="min-h-screen bg-gray-900">
		<!-- Header -->
		<div class="bg-gradient-to-r from-gray-800 to-gray-900 shadow-xl">
			<div class="max-w-7xl mx-auto px-4 py-8">
				<div class="flex items-center justify-between">
					<div>
						<h1 class="text-4xl font-bold text-white mb-2">💻 Компютри</h1>
						<p class="text-gray-400">Отдалечен достъп до служебните компютри</p>
					</div>
				</div>
			</div>
		</div>
		<!-- Agents table -->
		<div class="max-w-7xl mx-auto px-4 py-8">
			if len(rows) == 0 {
				<p class="text-gray-400">Няма конфигурирани компютри.</p>
			} else {
				<div class="bg-gray-800 rounded-2xl shadow-lg overflow-hidden">
					<table class="w-full text-left">
						<thead class="bg-gray-700/50">
							<tr>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Име</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Версия</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">ОС</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Ъптайм</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Статус</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range rows {
								<tr class="border-t border-gray-700">
									<td class="px-6 py-4">
										<span class="text-white font-medium">{ row.Name }</span>
										<span class="block text-xs text-gray-500 mt-1">{ row.URL }</span>
									</td>
									<td class="px-6 py-4 text-gray-300">{ row.Version }</td>
									<td class="px-6 py-4 text-gray-300">{ row.OS }</td>
									<td class="px-6 py-4 text-gray-300">{ row.Uptime }</td>
									<td class="px-6 py-4">
										if row.Online {
											<span class="text-green-400 font-medium">● Онлайн</span>
										} else {
											<span class="text-red-400 font-medium">● Офлайн</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}
