package templates

import "strconv"

templ Admin(rows []ComputerRow, errorMsg string) {
	<div class="min-h-screen bg-gray-900">
		<!-- Header -->
		<div class="bg-gradient-to-r from-gray-800 to-gray-900 shadow-xl">
			<div class="max-w-7xl mx-auto px-4 py-8">
				<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
					<div>
						<h1 class="text-4xl font-bold text-white mb-2">Administration</h1>
						<p class="text-gray-400">Add and remove computers</p>
					</div>
					<a href="/admin/users" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white font-semibold rounded-lg transition-all duration-200 whitespace-nowrap">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
							<circle cx="12" cy="7" r="4"></circle>
						</svg>
						Manage users
					</a>
				</div>
			</div>
		</div>
		<div class="max-w-7xl mx-auto px-4 py-8">
			if errorMsg != "" {
				<div class="bg-red-500/20 border border-red-500 text-red-400 px-4 py-3 rounded mb-6">
					{ errorMsg }
				</div>
			}
			<!-- Add device -->
			<div class="bg-gray-800 border border-gray-700 rounded-2xl p-6 mb-8">
				<h2 class="text-xl font-semibold text-white mb-4">Add computer</h2>
				<form method="POST" action="/admin/devices" class="flex flex-col md:flex-row gap-4">
					<input
						type="text"
						name="name"
						placeholder="Name, e.g. lab-pc-1"
						required=""
						class="flex-1 px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
					/>
					<input
						type="text"
						name="url"
						placeholder="Address, e.g. http://localhost:4101"
						required=""
						class="flex-1 px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
					/>
					<button
						type="submit"
						class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold rounded-lg transition-all duration-200"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path d="M12 5v14M5 12h14"></path>
						</svg>
						Add
					</button>
				</form>
			</div>
			<!-- Devices table -->
			if len(rows) == 0 {
				<p class="text-gray-400">No computers added.</p>
			} else {
				<div class="bg-gray-800 rounded-2xl shadow-lg overflow-x-auto">
					<table class="w-full text-left min-w-[760px]">
						<thead class="bg-gray-700/50">
							<tr>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Name</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Version</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">OS</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Uptime</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Last seen</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Status</th>
								<th class="px-6 py-4"></th>
							</tr>
						</thead>
						<tbody>
							for _, row := range rows {
								<tr class="border-t border-gray-700">
									<td class="px-6 py-4">
										<a href={ "/devices/" + strconv.FormatUint(uint64(row.ID), 10) } class="text-white font-medium hover:text-secondary transition-colors">
											{ row.Name }
										</a>
										if row.Verified {
											<span class="text-green-400 text-sm ml-1" title="Device completed pairing">✓</span>
										}
										<span class="block text-xs text-gray-500 mt-1">{ row.URL }</span>
									</td>
									<td class="px-6 py-4 text-gray-300">{ row.Version }</td>
									<td class="px-6 py-4 text-gray-300">{ row.OS }</td>
									<td class="px-6 py-4 text-gray-300">{ row.Uptime }</td>
									<td class="px-6 py-4 text-gray-300">{ row.LastSeen }</td>
									<td class="px-6 py-4">
										if row.Updating {
											<span class="text-amber-400 font-medium">● Updating</span>
										} else if row.Online {
											<span class="text-green-400 font-medium">● Online</span>
										} else {
											<span class="text-red-400 font-medium">● Offline</span>
										}
									</td>
									<td class="px-6 py-4 text-right">
										<form method="POST" action={ "/admin/devices/delete/" + strconv.FormatUint(uint64(row.ID), 10) }>
											<button
												type="submit"
												class="inline-flex items-center gap-1.5 px-4 py-2 bg-red-600/20 border border-red-500 text-red-400 rounded-lg hover:bg-red-600/40 transition-all duration-200"
											>
												<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
													<path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path>
												</svg>
												Delete
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}
