package templates

// Logged in user homepage
templ Index(email string) {
    <!-- Welcome Banner -->
    <div class="bg-neutral border border-gray-700 rounded-2xl p-6 mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold text-white mb-1">
                    Welcome back! 👋
                </h1>
                <p class="text-gray-400">
                    Signed in as <span class="text-secondary">{ email }</span>
                </p>
            </div>
            <a
                href="/account"
                class="hidden sm:flex items-center gap-2 text-gray-400 hover:text-secondary transition-colors"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                Settings
            </a>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        @quickAction("🛒", "My Cart", "/cart", "View items")
        @quickAction("📦", "Orders", "/orders", "Track orders")
        @quickAction("❤️", "Wishlist", "/wishlist", "Saved items")
        @quickAction("📋", "Weekly List", "/weeklyList", "Plan shopping")
    </div>

    <!-- Featured Products Section -->
    @featuredSection()

    <!-- Categories -->
    @categoriesSection()
}

// Guest homepage
templ GuestIndex() {
    <!-- Hero Section -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-gray-800 to-neutral border border-gray-700 mb-8">
        <div class="px-8 py-16 md:py-24 relative z-10">
            <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
                Welcome to <span class="text-secondary">MyShop</span>
            </h1>
            <p class="text-xl text-gray-300 mb-8 max-w-xl">
                Discover amazing products at great prices. Start shopping today!
            </p>
            <div class="flex flex-wrap gap-4">
                <a
                    href="/register"
                    class="inline-flex items-center gap-2 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold px-6 py-3 rounded-xl transition-all duration-200"
                >
                    Get Started
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                </a>
                <a
                    href="/products"
                    class="inline-flex items-center gap-2 bg-gray-700 hover:bg-gray-600 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200"
                >
                    Browse Products
                </a>
            </div>
        </div>
        <!-- Decorative elements -->
        <div class="absolute top-0 right-0 w-1/2 h-full opacity-10">
            <div class="absolute top-10 right-10 w-32 h-32 bg-secondary rounded-full blur-3xl"></div>
            <div class="absolute bottom-10 right-32 w-48 h-48 bg-amber-500 rounded-full blur-3xl"></div>
        </div>
    </div>

    <!-- Features -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        @featureCard("🚚", "Free Shipping", "On orders over $50")
        @featureCard("🔒", "Secure Payment", "100% protected")
        @featureCard("↩️", "Easy Returns", "30-day return policy")
    </div>

    <!-- Featured Products -->
    @featuredSection()

    <!-- Categories -->
    @categoriesSection()
}

// ============ REUSABLE COMPONENTS ============

templ quickAction(icon string, title string, href string, subtitle string) {
    <a
        href={ templ.SafeURL(href) }
        class="bg-neutral border border-gray-700 hover:border-secondary/50 rounded-xl p-4 transition-all duration-200 group"
    >
        <div class="text-2xl mb-2">{ icon }</div>
        <h3 class="font-semibold text-white group-hover:text-secondary transition-colors">{ title }</h3>
        <p class="text-sm text-gray-500">{ subtitle }</p>
    </a>
}

templ featureCard(icon string, title string, subtitle string) {
    <div class="bg-neutral border border-gray-700 rounded-xl p-6 text-center">
        <div class="text-3xl mb-3">{ icon }</div>
        <h3 class="font-semibold text-white mb-1">{ title }</h3>
        <p class="text-sm text-gray-400">{ subtitle }</p>
    </div>
}

templ featuredSection() {
    <section class="mb-8">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-white">Featured Products</h2>
            <a href="/products" class="text-secondary hover:text-amber-300 text-sm font-medium transition-colors">
                View all →
            </a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            @productCard("1", "Wireless Headphones", "$99.00", "https://via.placeholder.com/200x200/1a1a1a/666?text=🎧")
            @productCard("2", "Smart Watch", "$199.00", "https://via.placeholder.com/200x200/1a1a1a/666?text=⌚")
            @productCard("3", "Laptop Stand", "$49.00", "https://via.placeholder.com/200x200/1a1a1a/666?text=💻")
            @productCard("4", "USB-C Hub", "$79.00", "https://via.placeholder.com/200x200/1a1a1a/666?text=🔌")
        </div>
    </section>
}

templ productCard(id string, name string, price string, imageURL string) {
    <a
        href={ templ.SafeURL("/product/" + id) }
        class="bg-neutral border border-gray-700 rounded-xl overflow-hidden hover:border-secondary/50 transition-all duration-200 group"
    >
        <!-- Image -->
        <div class="aspect-square bg-gray-800 relative overflow-hidden">
            <img
                src={ imageURL }
                alt={ name }
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
        </div>
        <!-- Info -->
        <div class="p-4">
            <h3 class="font-medium text-white group-hover:text-secondary transition-colors truncate">
                { name }
            </h3>
            <p class="text-secondary font-bold mt-1">{ price }</p>
        </div>
    </a>
}

templ categoriesSection() {
    <section>
        <h2 class="text-xl font-bold text-white mb-6">Shop by Category</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            @categoryCard("Electronics", "🔌")
            @categoryCard("Clothing", "👕")
            @categoryCard("Home", "🏠")
            @categoryCard("Sports", "⚽")
            @categoryCard("Books", "📚")
            @categoryCard("Toys", "🧸")
        </div>
    </section>
}

templ categoryCard(name string, icon string) {
    <a
        href={ templ.SafeURL("/category/" + name) }
        class="bg-neutral border border-gray-700 hover:border-secondary/50 rounded-xl p-6 text-center transition-all duration-200 group"
    >
        <div class="text-3xl mb-2">{ icon }</div>
        <h3 class="font-medium text-gray-300 group-hover:text-white transition-colors">{ name }</h3>
    </a>
}
