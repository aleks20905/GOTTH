package templates

templ Index(email string) {
	<!-- Welcome Banner -->
	<div class="bg-neutral border border-gray-700 rounded-2xl p-6 mb-8">
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-2xl font-bold text-white mb-1">
					Добре дошли отново! 👋
				</h1>
				<p class="text-gray-400">
					Влезли сте като <span class="text-secondary">{ email }</span>
				</p>
			</div>
			<a
				href="/account"
				class="hidden sm:flex items-center gap-2 text-gray-400 hover:text-secondary transition-colors"
			>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
				</svg>
				Настройки
			</a>
		</div>
	</div>
	<!-- Quick Actions -->
	<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
		@quickAction("🥩", "Продукти", "/products", "Разгледай")
		@quickAction("👤", "Акаунт", "/account", "Твоят профил")
		@logoutAction("🔑")
		@quickAction("ℹ️", "За нас", "/about", "Научи повече")
	</div>
	<!-- Welcome Message -->
	@welcomeSection()
}

// Logout button
templ logoutAction(icon string) {
	<button
		type="button"
		hx-post="/logout"
		hx-target="body"
		hx-swap="innerHTML"
		class="bg-neutral border border-gray-700 hover:border-secondary/50 rounded-xl p-4 transition-all duration-200 group text-left items-start justify-start block w-full appearance-none cursor-pointer"
	>
		<div class="text-2xl mb-2">{ icon }</div>
		<h3 class="font-semibold text-white group-hover:text-secondary transition-colors">Изход</h3>
		<p class="text-sm text-gray-500">Излез</p>
	</button>
}

// Guest homepage
templ GuestIndex() {
	<!-- Hero Section -->
	<div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-gray-800 to-neutral border border-gray-700 mb-8">
		<div class="px-8 py-16 md:py-24 relative z-10">
			<h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
				Добре дошли в <span class="text-secondary">МесоМаркет</span>
			</h1>
			<p class="text-xl text-gray-300 mb-8 max-w-xl">
				Пресни и качествени месни продукти, директно до вашата врата. Открийте най-доброто българско месо!
			</p>
			<div class="flex flex-wrap gap-4">
				<a
					href="/products"
					class="inline-flex items-center gap-2 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold px-6 py-3 rounded-xl transition-all duration-200"
				>
					Разгледай продукти
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
					</svg>
				</a>
				<a
					href="/register"
					class="inline-flex items-center gap-2 bg-gray-700 hover:bg-gray-600 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200"
				>
					Регистрация
				</a>
				<a
					href="/login"
					class="inline-flex items-center gap-2 bg-gray-700 hover:bg-gray-600 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200"
				>
					Вход
				</a>
			</div>
		</div>
		<!-- Decorative elements -->
		<div class="absolute top-0 right-0 w-1/2 h-full opacity-10">
			<div class="absolute top-10 right-10 w-32 h-32 bg-secondary rounded-full blur-3xl"></div>
			<div class="absolute bottom-10 right-32 w-48 h-48 bg-amber-500 rounded-full blur-3xl"></div>
		</div>
	</div>
	<!-- Meat Showcase Section -->
	<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
		<!-- Big meat image/icon card -->
		<div class="bg-neutral border border-gray-700 rounded-2xl p-8 flex flex-col items-center justify-center text-center">
			<div class="text-9xl mb-6">🥩</div>
			<h2 class="text-2xl font-bold text-white mb-3">Прясно месо всеки ден</h2>
			<p class="text-gray-400 leading-relaxed">
				Предлагаме внимателно подбрано телешко, свинско, пилешко и агнешко месо от проверени български ферми. Качеството е нашият приоритет.
			</p>
		</div>
		<!-- Info cards stack -->
		<div class="flex flex-col gap-6">
			@meatInfoCard("🐄", "Телешко месо", "Нежно и сочно телешко от пасищни животни, отгледани в българските планини.")
			@meatInfoCard("🐖", "Свинско месо", "Традиционно българско свинско — перфектно за скара, кебапчета и наденица.")
			@meatInfoCard("🐔", "Пилешко месо", "Пресни пилешки гърди, бутчета и крилца от свободно отглеждани кокошки.")
		</div>
	</div>
	<!-- Browse Products Banner -->
	<div class="bg-neutral border border-gray-700 rounded-2xl p-6 mb-8">
		<div class="flex flex-col sm:flex-row items-center justify-between gap-4">
			<div class="flex items-center gap-4">
				<div class="text-5xl">🔥</div>
				<div>
					<h3 class="text-xl font-bold text-white">Готови за пазаруване?</h3>
					<p class="text-gray-400">Разгледайте нашите продукти без регистрация</p>
				</div>
			</div>
			<a
				href="/products"
				class="inline-flex items-center gap-2 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold px-6 py-3 rounded-xl transition-all duration-200 whitespace-nowrap"
			>
				Към продуктите
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
				</svg>
			</a>
		</div>
	</div>
	<!-- Call to Action -->
	@ctaSection()
}

// ============ REUSABLE COMPONENTS ============
templ meatInfoCard(icon string, title string, description string) {
	<div class="bg-neutral border border-gray-700 rounded-xl p-6 flex items-start gap-4 hover:border-secondary/30 transition-all duration-200">
		<div class="text-4xl flex-shrink-0">{ icon }</div>
		<div>
			<h3 class="font-semibold text-white mb-1">{ title }</h3>
			<p class="text-sm text-gray-400 leading-relaxed">{ description }</p>
		</div>
	</div>
}

templ quickAction(icon string, title string, href string, subtitle string) {
	<a
		href={ templ.SafeURL(href) }
		class="bg-neutral border border-gray-700 hover:border-secondary/50 rounded-xl p-4 transition-all duration-200 group flex flex-col"
	>
		<div class="text-2xl mb-2">{ icon }</div>
		<h3 class="font-semibold text-white group-hover:text-secondary transition-colors">{ title }</h3>
		<p class="text-sm text-gray-500">{ subtitle }</p>
	</a>
}

templ welcomeSection() {
	<section class="mb-8">
		<div class="bg-neutral border border-gray-700 rounded-2xl p-8 text-center">
			<div class="text-6xl mb-4">🥩</div>
			<h2 class="text-2xl font-bold text-white mb-2">Време е за пазаруване!</h2>
			<p class="text-gray-400 mb-6 max-w-md mx-auto">
				Разгледайте нашата колекция от пресни месни продукти и намерете точно това, което ви трябва.
			</p>
			<a
				href="/products"
				class="inline-flex items-center gap-2 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold px-6 py-3 rounded-xl transition-all duration-200"
			>
				Разгледай продукти
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
				</svg>
			</a>
		</div>
	</section>
}

templ ctaSection() {
	<section>
		<div class="bg-gradient-to-r from-gray-800 to-gray-700 border border-gray-600 rounded-2xl p-8 text-center">
			<h2 class="text-2xl font-bold text-white mb-2">Присъединете се към нас</h2>
			<p class="text-gray-300 mb-6 max-w-md mx-auto">
				Създайте акаунт, за да запазвате любими продукти, да следите поръчки и да получавате ексклузивни оферти.
			</p>
			<div class="flex flex-wrap justify-center gap-4">
				<a
					href="/register"
					class="inline-flex items-center gap-2 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold px-6 py-3 rounded-xl transition-all duration-200"
				>
					Създай акаунт
				</a>
				<a
					href="/login"
					class="inline-flex items-center gap-2 bg-gray-600 hover:bg-gray-500 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200"
				>
					Вход
				</a>
			</div>
		</div>
	</section>
}
