package templates

import (
	"goth/internal/store"
	"strconv"
)

templ Index(email string, stats HomeStats, recent []store.LogEntry) {
	<!-- Welcome Banner -->
	<div class="bg-neutral border border-gray-700 rounded-2xl p-6 mb-8">
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-2xl font-bold text-white mb-1">
					Welcome back!
				</h1>
				<p class="text-gray-400">
					Signed in as <span class="text-secondary">{ email }</span>
				</p>
			</div>
			<a
				href="/account"
				class="hidden sm:flex items-center gap-2 text-gray-400 hover:text-secondary transition-colors"
			>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
				</svg>
				Settings
			</a>
		</div>
	</div>
	<!-- Fleet stats -->
	<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
		@statCard("Computers", stats.Total, "text-white")
		@statCard("Online", stats.Online, "text-green-400")
		@statCard("Updating", stats.Updating, "text-amber-400")
		@statCard("Open tasks", stats.PendingTasks, "text-white")
	</div>
	<!-- Quick Actions -->
	<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-8">
		@quickAction("monitor", "Computers", "/computers", "Status")
		@quickAction("user", "Account", "/account", "Your profile")
		@logoutAction()
	</div>
	<!-- Recent activity -->
	<div class="bg-neutral border border-gray-700 rounded-2xl p-6">
		<h2 class="text-xl font-semibold text-white mb-4">Recent activity</h2>
		if len(recent) == 0 {
			<p class="text-gray-400 text-sm">Nothing happened yet.</p>
		} else {
			<ul class="space-y-3">
				for _, entry := range recent {
					<li class="flex items-start gap-3 text-sm">
						if entry.Level == "error" {
							<span class="mt-1.5 w-2 h-2 rounded-full bg-red-400 flex-shrink-0"></span>
						} else {
							<span class="mt-1.5 w-2 h-2 rounded-full bg-green-400 flex-shrink-0"></span>
						}
						<div>
							<span class="text-white">{ entry.Message }</span>
							if entry.Details != "" {
								<span class="text-gray-500"> — { entry.Details }</span>
							}
							<span class="block text-xs text-gray-500 mt-0.5">{ entry.Timestamp.Format("02.01 15:04") }</span>
						</div>
					</li>
				}
			</ul>
		}
	</div>
}

templ statCard(title string, value int, valueClass string) {
	<div class="bg-neutral border border-gray-700 rounded-xl p-4">
		<div class={ "text-3xl font-bold " + valueClass }>{ strconv.Itoa(value) }</div>
		<p class="text-sm text-gray-500 mt-1">{ title }</p>
	</div>
}

templ logoutAction() {
	<button
		type="button"
		hx-post="/logout"
		hx-target="body"
		hx-swap="innerHTML"
		class="bg-neutral border border-gray-700 hover:border-secondary/50 rounded-xl p-4 transition-all duration-200 group text-left items-start justify-start block w-full appearance-none cursor-pointer"
	>
		<div class="text-gray-400 mb-2">
			<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
				<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path>
			</svg>
		</div>
		<h3 class="font-semibold text-white group-hover:text-secondary transition-colors">Sign out</h3>
		<p class="text-sm text-gray-500">End your session</p>
	</button>
}

templ GuestIndex() {
	<!-- Hero Section -->
	<div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-gray-800 to-neutral border border-gray-700 mb-8">
		<div class="px-8 py-16 md:py-24 relative z-10">
			<h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
				Welcome to <span class="text-secondary">RemoteDesk</span>
			</h1>
			<p class="text-xl text-gray-300 mb-8 max-w-xl">
				Monitor your office computers from one place — versions, operating systems and real-time availability.
			</p>
			<div class="flex flex-wrap gap-4">
				<a
					href="/computers"
					class="inline-flex items-center gap-2 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold px-6 py-3 rounded-xl transition-all duration-200"
				>
					View computers
					<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
						<path d="M5 12h14M12 5l7 7-7 7"></path>
					</svg>
				</a>
				<a
					href="/register"
					class="inline-flex items-center gap-2 bg-gray-700 hover:bg-gray-600 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200"
				>
					Sign up
				</a>
				<a
					href="/login"
					class="inline-flex items-center gap-2 bg-gray-700 hover:bg-gray-600 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200"
				>
					Sign in
				</a>
			</div>
		</div>
		<!-- Decorative elements -->
		<div class="absolute top-0 right-0 w-1/2 h-full opacity-10">
			<div class="absolute top-10 right-10 w-32 h-32 bg-secondary rounded-full blur-3xl"></div>
			<div class="absolute bottom-10 right-32 w-48 h-48 bg-amber-500 rounded-full blur-3xl"></div>
		</div>
	</div>
	<!-- System Showcase Section -->
	<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
		<!-- Big icon card -->
		<div class="bg-neutral border border-gray-700 rounded-2xl p-8 flex flex-col items-center justify-center text-center">
			<div class="text-gray-500 mb-6">
				<svg class="w-24 h-24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
					<rect x="2" y="3" width="20" height="14" rx="2"></rect>
					<path d="M8 21h8m-4-4v4"></path>
				</svg>
			</div>
			<h2 class="text-2xl font-bold text-white mb-3">All computers in one place</h2>
			<p class="text-gray-400 leading-relaxed">
				Track agent versions, operating systems and uptime for every machine. The dashboard refreshes on every load.
			</p>
		</div>
		<!-- Info cards stack -->
		<div class="flex flex-col gap-6">
			@infoCard("monitor", "Monitoring", "Version, OS and uptime for every computer, collected from the local agents.")
			@infoCard("activity", "Real-time status", "Online and offline machine state right on the dashboard.")
			@infoCard("shield", "Sign-in required", "The computers page is only available to signed-in users.")
		</div>
	</div>
	<!-- Browse Computers Banner -->
	<div class="bg-neutral border border-gray-700 rounded-2xl p-6 mb-8">
		<div class="flex flex-col sm:flex-row items-center justify-between gap-4">
			<div class="flex items-center gap-4">
				<div class="text-gray-500">
					<svg class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
						<rect x="2" y="3" width="20" height="14" rx="2"></rect>
						<path d="M8 21h8m-4-4v4"></path>
					</svg>
				</div>
				<div>
					<h3 class="text-xl font-bold text-white">Ready to work?</h3>
					<p class="text-gray-400">Check the status of your computers</p>
				</div>
			</div>
			<a
				href="/computers"
				class="inline-flex items-center gap-2 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold px-6 py-3 rounded-xl transition-all duration-200 whitespace-nowrap"
			>
				Open dashboard
				<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path d="M5 12h14M12 5l7 7-7 7"></path>
				</svg>
			</a>
		</div>
	</div>
	<!-- Call to Action -->
	@ctaSection()
}

templ infoCard(icon string, title string, description string) {
	<div class="bg-neutral border border-gray-700 rounded-xl p-6 flex items-start gap-4 hover:border-secondary/30 transition-all duration-200">
		<div class="text-gray-500 flex-shrink-0">
			if icon == "monitor" {
				<svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
					<rect x="2" y="3" width="20" height="14" rx="2"></rect>
					<path d="M8 21h8m-4-4v4"></path>
				</svg>
			} else if icon == "activity" {
				<svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
					<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
				</svg>
			} else {
				<svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
					<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
				</svg>
			}
		</div>
		<div>
			<h3 class="font-semibold text-white mb-1">{ title }</h3>
			<p class="text-sm text-gray-400 leading-relaxed">{ description }</p>
		</div>
	</div>
}

templ quickAction(icon string, title string, href string, subtitle string) {
	<a
		href={ templ.SafeURL(href) }
		class="bg-neutral border border-gray-700 hover:border-secondary/50 rounded-xl p-4 transition-all duration-200 group flex flex-col"
	>
		<div class="text-gray-400 mb-2">
			if icon == "monitor" {
				<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<rect x="2" y="3" width="20" height="14" rx="2"></rect>
					<path d="M8 21h8m-4-4v4"></path>
				</svg>
			} else if icon == "user" {
				<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
					<circle cx="12" cy="7" r="4"></circle>
				</svg>
			} else {
				<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<circle cx="12" cy="12" r="10"></circle>
					<path d="M12 16v-4m0-4h.01"></path>
				</svg>
			}
		</div>
		<h3 class="font-semibold text-white group-hover:text-secondary transition-colors">{ title }</h3>
		<p class="text-sm text-gray-500">{ subtitle }</p>
	</a>
}

templ ctaSection() {
	<section>
		<div class="bg-gradient-to-r from-gray-800 to-gray-700 border border-gray-600 rounded-2xl p-8 text-center">
			<h2 class="text-2xl font-bold text-white mb-2">Join us</h2>
			<p class="text-gray-300 mb-6 max-w-md mx-auto">
				Create an account to get access to the computers dashboard.
			</p>
			<div class="flex flex-wrap justify-center gap-4">
				<a
					href="/register"
					class="inline-flex items-center gap-2 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold px-6 py-3 rounded-xl transition-all duration-200"
				>
					Create account
				</a>
				<a
					href="/login"
					class="inline-flex items-center gap-2 bg-gray-600 hover:bg-gray-500 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200"
				>
					Sign in
				</a>
			</div>
		</div>
	</section>
}
