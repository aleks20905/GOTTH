package templates

import (
	"goth/internal/store"
	"strconv"
)

templ Updates(tasks []TaskRow, devices []store.Device, groups []store.DeviceGroup, errorMsg string) {
	<div class="min-h-screen bg-gray-900">
		<div class="bg-gradient-to-r from-gray-800 to-gray-900 shadow-xl">
			<div class="max-w-7xl mx-auto px-4 py-8">
				<h1 class="text-4xl font-bold text-white mb-2">Updates</h1>
				<p class="text-gray-400">Schedule and run software updates</p>
			</div>
		</div>
		<div class="max-w-7xl mx-auto px-4 py-8">
			if errorMsg != "" {
				<div class="bg-red-500/20 border border-red-500 text-red-400 px-4 py-3 rounded mb-6">
					if errorMsg == "empty" {
						Package and version are required.
					} else if errorMsg == "target" {
						Select a device or a group.
					} else {
						Invalid date. Format: YYYY-MM-DD HH:MM.
					}
				</div>
			}
			<div class="bg-gray-800 border border-gray-700 rounded-2xl p-6 mb-8">
				<h2 class="text-xl font-semibold text-white mb-4">New task</h2>
				<form method="POST" action="/admin/updates" class="grid grid-cols-1 md:grid-cols-3 gap-4">
					<input
						type="text"
						name="package"
						placeholder="Package, e.g. office-agent"
						required=""
						class="px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
					/>
					<input
						type="text"
						name="version"
						placeholder="Version, e.g. 2.0.0"
						required=""
						class="px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
					/>
					<input
						type="datetime-local"
						name="scheduled_at"
						class="px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
					/>
					<select name="device_id" class="px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white transition">
						<option value="0">— Device —</option>
						for _, device := range devices {
							<option value={ strconv.FormatUint(uint64(device.ID), 10) }>{ device.Name }</option>
						}
					</select>
					<select name="group_id" class="px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white transition">
						<option value="0">— Group —</option>
						for _, group := range groups {
							<option value={ strconv.FormatUint(uint64(group.ID), 10) }>{ group.Name }</option>
						}
					</select>
					<button
						type="submit"
						class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold rounded-lg transition-all duration-200"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path d="M12 5v14M5 12h14"></path>
						</svg>
						Create
					</button>
				</form>
				<p class="text-gray-500 text-sm mt-3">Empty date means immediately. Select either a device or a group.</p>
			</div>
			if len(tasks) == 0 {
				<p class="text-gray-400">No tasks.</p>
			} else {
				<div class="bg-gray-800 rounded-2xl shadow-lg overflow-x-auto">
					<table class="w-full text-left min-w-[680px]">
						<thead class="bg-gray-700/50">
							<tr>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Package</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Version</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Target</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Status</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Created by</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range tasks {
								<tr class="border-t border-gray-700">
									<td class="px-6 py-4 text-white font-medium">{ row.Task.PackageName }</td>
									<td class="px-6 py-4 text-gray-300">{ row.Task.PackageVersion }</td>
									<td class="px-6 py-4 text-gray-300">{ row.Target }</td>
									<td class="px-6 py-4">
										if row.Task.Status == "completed" {
											<span class="text-green-400 font-medium">● Completed</span>
										} else if row.Task.Status == "running" {
											<span class="text-amber-400 font-medium">● Running</span>
										} else if row.Task.Status == "failed" {
											<span class="text-red-400 font-medium">● Failed</span>
										} else {
											<span class="text-gray-400 font-medium">● Pending</span>
										}
									</td>
									<td class="px-6 py-4 text-gray-300">{ row.Task.CreatedBy }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}
