package templates

import (
    "fmt"
    "goth/internal/store"
)

type ProductData struct {
    ID          string
    Name        string
    Description string
    Price       float64
    Weight      string
    Image       string
    Category    string
    InStock     bool
}

templ ProductDetail(product store.Product) {
    <div class="min-h-screen bg-gray-900">
        <!-- Header -->
        <div class="bg-gray-800 shadow-lg">
            <div class="max-w-6xl mx-auto px-4 py-6">
                <div class="flex items-center justify-between">
                    <a href="/products" class="text-xl font-bold text-white hover:text-blue-400 transition">
                        ← Back to Products
                    </a>
                    <a href="/cart" class="relative bg-gray-700 hover:bg-gray-600 p-4 rounded-xl transition">
                        <span class="text-2xl">🛒</span>
                        <span id="cart-badge">
                            @CartBadge(0)
                        </span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Product Detail -->
        <div class="max-w-6xl mx-auto px-4 py-12">
            <div class="bg-gray-800 rounded-3xl overflow-hidden shadow-2xl">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
                    
                    <!-- Product Image -->
                    <div class="bg-gradient-to-br from-gray-700 to-gray-800 p-12 flex items-center justify-center min-h-96">
                        <span class="text-[12rem]">{ product.Image }</span>
                    </div>

                    <!-- Product Info -->
                    <div class="p-8 lg:p-12 flex flex-col justify-center">
                        <!-- Category badge -->
                        <span class="inline-block bg-blue-600 text-white text-sm px-3 py-1 rounded-full w-fit mb-4">
                            { product.Category }
                        </span>

                        <h1 class="text-4xl font-bold text-white mb-4">{ product.Name }</h1>
                        
                        <p class="text-gray-400 text-lg mb-6">{ product.Description }</p>

                        <!-- Details -->
                        <div class="grid grid-cols-2 gap-4 mb-6">
                            <div class="bg-gray-700 rounded-xl p-4">
                                <p class="text-gray-400 text-sm">Weight</p>
                                <p class="text-white font-bold text-lg">{ product.Weight }</p>
                            </div>
                            <div class="bg-gray-700 rounded-xl p-4">
                                <p class="text-gray-400 text-sm">Stock</p>
                                if product.Stock > 0 {
                                    <p class="text-green-400 font-bold text-lg">{ fmt.Sprintf("%d", product.Stock) } available</p>
                                } else {
                                    <p class="text-red-400 font-bold text-lg">Out of stock</p>
                                }
                            </div>
                        </div>

                        <!-- Price -->
                        <div class="flex items-center justify-between mb-8">
                            <span class="text-4xl font-bold text-green-400">
                                ${ fmt.Sprintf("%.2f", product.Price) }
                            </span>
                            <span class="text-gray-500">per pack</span>
                        </div>

                        <!-- Quantity selector + Add to cart -->
                        if product.Stock > 0 {
                            <div class="space-y-4">
                                <!-- Quantity selector -->
                                <div class="flex items-center gap-4">
                                    <span class="text-gray-400">Quantity:</span>
                                    <div class="flex items-center bg-gray-700 rounded-xl">
                                        <button 
                                            type="button"
                                            onclick="updateQty(-1)"
                                            class="w-12 h-12 text-white hover:bg-gray-600 rounded-l-xl transition font-bold text-xl"
                                        >-</button>
                                        <input 
                                            type="number" 
                                            id="quantity" 
                                            name="quantity" 
                                            value="1" 
                                            min="1" 
                                            max={ fmt.Sprintf("%d", product.Stock) }
                                            class="w-16 h-12 bg-transparent text-white text-center font-bold text-lg border-0 focus:outline-none"
                                        />
                                        <button 
                                            type="button"
                                            onclick="updateQty(1)"
                                            class="w-12 h-12 text-white hover:bg-gray-600 rounded-r-xl transition font-bold text-xl"
                                        >+</button>
                                    </div>
                                </div>

                                <!-- Add to cart button -->
                                <button 
                                    id="add-to-cart-btn"
                                    class="w-full py-4 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white font-bold text-xl rounded-xl shadow-lg hover:shadow-xl transition-all duration-200"
                                    hx-post={ fmt.Sprintf("/cart/add/%d", product.ID) }
                                    hx-target="#cart-badge"
                                    hx-swap="innerHTML"
                                    hx-include="#quantity"
                                    onclick="showAddedFeedback(this)"
                                >
                                    🛒 Add to Cart
                                </button>

                                <!-- Success message -->
                                <div id="add-success" class="hidden text-center text-green-400 font-bold py-2">
                                    ✓ Added to cart!
                                </div>
                            </div>
                        } else {
                            <button disabled class="w-full py-4 bg-gray-600 text-gray-400 font-bold text-xl rounded-xl cursor-not-allowed">
                                Out of Stock
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function updateQty(delta) {
            const input = document.getElementById('quantity');
            const newVal = parseInt(input.value) + delta;
            const max = parseInt(input.max);
            if (newVal >= 1 && newVal <= max) {
                input.value = newVal;
            }
        }

        function showAddedFeedback(btn) {
            const successMsg = document.getElementById('add-success');
            successMsg.classList.remove('hidden');
            btn.textContent = '✓ Added!';
            btn.classList.remove('from-blue-600', 'to-purple-600');
            btn.classList.add('from-green-600', 'to-green-600');
            
            setTimeout(() => {
                successMsg.classList.add('hidden');
                btn.textContent = '🛒 Add to Cart';
                btn.classList.remove('from-green-600', 'to-green-600');
                btn.classList.add('from-blue-600', 'to-purple-600');
            }, 2000);
        }
    </script>
}

templ ProductList(products []ProductData) {
    <div class="min-h-screen bg-gray-900 py-12 px-4">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-12">
                <h1 class="text-4xl font-bold text-white mb-4">
                    🥩 Our Meats
                </h1>
                <p class="text-gray-400 text-lg">
                    Premium quality meats delivered fresh to your door
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                for _, product := range products {
                    <a href={ templ.SafeURL("/products/" + product.ID) } class="group">
                        <div class="bg-gray-800 rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
                            <!-- Product Image -->
                            <div class="bg-gray-700 h-48 flex items-center justify-center group-hover:bg-gray-600 transition">
                                <span class="text-7xl">{ product.Image }</span>
                            </div>

                            <!-- Product Info -->
                            <div class="p-6">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-xs px-2 py-1 bg-blue-600 text-white rounded-full">
                                        { product.Category }
                                    </span>
                                    if product.InStock {
                                        <span class="text-xs text-green-400">● In Stock</span>
                                    } else {
                                        <span class="text-xs text-red-400">● Out of Stock</span>
                                    }
                                </div>

                                <h3 class="text-xl font-bold text-white mb-2 group-hover:text-blue-400 transition">
                                    { product.Name }
                                </h3>

                                <p class="text-gray-400 text-sm mb-4 line-clamp-2">
                                    { product.Description }
                                </p>

                                <div class="flex items-center justify-between">
                                    <span class="text-2xl font-bold text-green-400">
                                        ${ fmt.Sprintf("%.2f", product.Price) }
                                    </span>
                                    <span class="text-gray-500 text-sm">
                                        { product.Weight }
                                    </span>
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
}
