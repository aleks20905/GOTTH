package templates

templ Account(email string, msg string) {
	<div class="max-w-2xl mx-auto">
		<div class="bg-gradient-to-r from-gray-800 to-gray-900 shadow-xl rounded-2xl">
			<div class="px-6 py-8">
				<a href="/" class="text-gray-400 hover:text-secondary transition-colors text-sm">← Home</a>
				<h1 class="text-3xl font-bold text-white mt-2 mb-2">Account</h1>
				<p class="text-gray-400">Signed in as <span class="text-secondary">{ email }</span></p>
			</div>
		</div>
		<div class="py-8 space-y-8">
			if msg == "email-updated" {
				<div class="bg-green-500/20 border border-green-500 text-green-400 px-4 py-3 rounded">
					Email updated.
				</div>
			}
			if msg == "email-taken" {
				<div class="bg-red-500/20 border border-red-500 text-red-400 px-4 py-3 rounded">
					This email is already taken.
				</div>
			}
			if msg == "email-invalid" {
				<div class="bg-red-500/20 border border-red-500 text-red-400 px-4 py-3 rounded">
					Enter a valid email address.
				</div>
			}
			if msg == "password-updated" {
				<div class="bg-green-500/20 border border-green-500 text-green-400 px-4 py-3 rounded">
					Password updated.
				</div>
			}
			if msg == "password-wrong" {
				<div class="bg-red-500/20 border border-red-500 text-red-400 px-4 py-3 rounded">
					Current password is wrong.
				</div>
			}
			if msg == "password-short" {
				<div class="bg-red-500/20 border border-red-500 text-red-400 px-4 py-3 rounded">
					New password must be at least 8 characters.
				</div>
			}
			<!-- Change email -->
			<div class="bg-gray-800 border border-gray-700 rounded-2xl p-6">
				<h2 class="text-xl font-semibold text-white mb-4">Change email</h2>
				<form method="POST" action="/account/email" class="flex flex-col md:flex-row gap-4">
					<input
						type="email"
						name="email"
						placeholder="New email address"
						value={ email }
						required=""
						class="flex-1 px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
					/>
					<button
						type="submit"
						class="px-6 py-3 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold rounded-lg transition-all duration-200"
					>
						Save
					</button>
				</form>
			</div>
			<!-- Change password -->
			<div class="bg-gray-800 border border-gray-700 rounded-2xl p-6">
				<h2 class="text-xl font-semibold text-white mb-4">Change password</h2>
				<form method="POST" action="/account/password" class="flex flex-col gap-4">
					<input
						type="password"
						name="current_password"
						placeholder="Current password"
						required=""
						autocomplete="current-password"
						class="px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
					/>
					<input
						type="password"
						name="new_password"
						placeholder="New password (min. 8 characters)"
						required=""
						minlength="8"
						autocomplete="new-password"
						class="px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
					/>
					<button
						type="submit"
						class="px-6 py-3 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold rounded-lg transition-all duration-200 md:self-start"
					>
						Update password
					</button>
				</form>
			</div>
		</div>
	</div>
}
