package templates

import (
    "os"
    "goth/internal/middleware"
)

templ header(title string) {
    <head>
        <title>{ title }</title>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <script src="/static/script/htmx.min.js" nonce={ middleware.GetHtmxNonce(ctx) }></script>
        <script src="/static/script/response-targets.js" nonce={ middleware.GetResponseTargetsNonce(ctx) }></script>
        if os.Getenv("env") == "production" {
            <link rel="stylesheet" href="/static/css/style.min.css" nonce={ middleware.GetTwNonce(ctx) }/>
        } else {
            <link rel="stylesheet" href="/static/css/style.css" nonce={ middleware.GetTwNonce(ctx) }/>
        }
    </head>
}

templ footer() {
    <footer class="bg-navbarBackground border-t border-gray-800">
        <div class="container mx-auto px-4 py-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Brand -->
                <div>
                    <h3 class="text-lg font-bold text-white mb-4">🛒 MyShop</h3>
                    <p class="text-gray-400 text-sm">
                        Your one-stop shop for everything.
                    </p>
                </div>
                <!-- Links -->
                <div>
                    <h4 class="font-semibold text-white mb-4">Quick Links</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="/" class="text-gray-400 hover:text-secondary transition-colors">Home</a></li>
                        <li><a href="/about" class="text-gray-400 hover:text-secondary transition-colors">About</a></li>
                    </ul>
                </div>
                <!-- Contact -->
                <div>
                    <h4 class="font-semibold text-white mb-4">Contact</h4>
                    <p class="text-sm text-gray-400">hello@myshop.com</p>
                </div>
            </div>
            <div class="border-t border-gray-800 mt-8 pt-6 text-center text-sm text-gray-500">
                © 2024 MyShop. All rights reserved.
            </div>
        </div>
    </footer>
}

templ nav() {
    <nav class="bg-navbarBackground border-b border-gray-800 sticky top-0 z-50">
        <div class="container mx-auto px-4">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <a href="/" class="text-xl font-bold text-white hover:text-secondary transition-colors">
                    🛒 MyShop
                </a>

                <!-- Center nav links -->
                <ul class="hidden md:flex items-center space-x-1">
                    <li>
                        <a class="text-gray-300 hover:text-white hover:bg-gray-800 px-4 py-2 rounded-lg transition-all duration-200" href="/">
                            Home
                        </a>
                    </li>
                    <li>
                        <a class="text-gray-300 hover:text-white hover:bg-gray-800 px-4 py-2 rounded-lg transition-all duration-200" href="/about">
                            About
                        </a>
                    </li>
                </ul>

                <!-- Right side - Auth -->
                <div class="flex items-center space-x-3">
                    if middleware.GetUser(ctx) != nil {
                        <!-- Cart icon -->
                        <a href="/cart" class="text-gray-300 hover:text-secondary p-2 rounded-lg transition-all duration-200 relative">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                        </a>
                        <button
                            class="text-gray-300 hover:text-white hover:bg-gray-800 px-4 py-2 rounded-lg transition-all duration-200"
                            hx-target="body"
                            hx-swap="innerHTML"
                            hx-post="/logout"
                        >
                            Logout
                        </button>
                    } else {
                        <a
                            class="text-gray-300 hover:text-white hover:bg-gray-800 px-4 py-2 rounded-lg transition-all duration-200"
                            href="/login"
                        >
                            Login
                        </a>
                        <a
                            class="bg-secondary hover:bg-amber-300 text-gray-900 px-4 py-2 rounded-lg transition-all duration-200 font-medium"
                            href="/register"
                        >
                            Register
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>
}

templ Layout(contents templ.Component, title string) {
    <!DOCTYPE html>
    <html lang="en">
        @header(title)
        <body class="bg-background text-text flex flex-col min-h-screen">
            @nav()
            <main class="flex-1 container mx-auto px-4 py-8">
                @contents
            </main>
            @footer()
        </body>
    </html>
}
