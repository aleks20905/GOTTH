package templates

import (
	"fmt"
	"goth/internal/store"
)

templ Products(products []store.Product) {
	<div class="min-h-screen bg-gray-900">
		<!-- Header -->
		<div class="bg-gradient-to-r from-gray-800 to-gray-900 shadow-xl">
			<div class="max-w-7xl mx-auto px-4 py-8">
				<div class="flex items-center justify-between">
					<div>
						<h1 class="text-4xl font-bold text-white mb-2">🥩 Premium Meats</h1>
						<p class="text-gray-400">Farm-fresh quality, delivered to your door</p>
					</div>
					<a href="/cart" class="relative bg-gray-700 hover:bg-gray-600 p-4 rounded-xl transition">
						<span class="text-2xl">🛒</span>
						<span id="cart-badge">
							@CartBadge()
						</span>
					</a>
				</div>
			</div>
		</div>
		<!-- Products Grid -->
		<div class="max-w-7xl mx-auto px-4 py-8">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				for _, product := range products {
					@ProductCard(product)
				}
			</div>
		</div>
	</div>
}

templ ProductCard(product store.Product) {
	<div class="bg-gray-800 rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 flex flex-col">
		<!-- Product Image -->
		<div class="bg-gradient-to-br from-gray-700 to-gray-800 p-8 flex items-center justify-center">
			<span class="text-8xl">{ product.Image }</span>
		</div>
		<!-- Product Info -->
		<div class="p-6 flex-grow flex flex-col">
			<div class="flex justify-between items-start mb-2">
				<h3 class="text-xl font-bold text-white">{ product.Name }</h3>
				<span class="bg-blue-600 text-white text-xs px-2 py-1 rounded-full">
					{ product.Category }
				</span>
			</div>
			<p class="text-gray-400 text-sm mb-4 flex-grow">{ product.Description }</p>
			<div class="flex items-center justify-between mb-4">
				<span class="text-2xl font-bold text-green-400">
					€{ fmt.Sprintf("%.2f", product.Price) }
				</span>
				<span class="text-gray-500 text-sm">{ product.Weight }</span>
			</div>
			<!-- Stock indicator -->
			if product.Stock > 0 {
				<p class="text-green-400 text-sm mb-4">✓ In stock ({ fmt.Sprintf("%d", product.Stock) } available)</p>
			} else {
				<p class="text-red-400 text-sm mb-4">✗ Out of stock</p>
			}
			<!-- Action buttons -->
			<div class="flex gap-3">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/products/%d", product.ID)) }
					class="flex-1 bg-gray-700 hover:bg-gray-600 text-white font-bold py-3 rounded-xl text-center transition"
				>
					View Details
				</a>
				if product.Stock > 0 {
					<button
						class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition"
						hx-post={ fmt.Sprintf("/cart/add/%d", product.ID) }
						hx-target="#cart-badge"
						hx-swap="innerHTML"
					>
						🛒 Add
					</button>
				} else {
					<button
						disabled
						class="flex-1 bg-gray-600 text-gray-400 font-bold py-3 rounded-xl cursor-not-allowed"
					>
						Sold Out
					</button>
				}
			</div>
		</div>
	</div>
}
