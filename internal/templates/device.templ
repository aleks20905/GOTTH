package templates

import (
	"goth/internal/store"
	"strconv"
)

templ DeviceDetail(device store.Device, row ComputerRow, rules []store.FirewallRule, tasks []store.UpdateTask, applied string, powerNotice string, consoleOut string) {
	<div class="min-h-screen bg-gray-900">
		<div class="bg-gradient-to-r from-gray-800 to-gray-900 shadow-xl">
			<div class="max-w-7xl mx-auto px-4 py-8">
				<a href="/computers" class="text-gray-400 hover:text-secondary transition-colors text-sm">← Computers</a>
				<h1 class="text-4xl font-bold text-white mt-2 mb-2">
					{ device.Name }
					if row.Verified {
						<span class="text-green-400 text-2xl ml-1" title="Device completed pairing">✓</span>
					}
				</h1>
				<p class="text-gray-400">{ device.URL }</p>
			</div>
		</div>
		<div class="max-w-7xl mx-auto px-4 py-8 space-y-8">
			if applied == "ok" {
				<div class="bg-green-500/20 border border-green-500 text-green-400 px-4 py-3 rounded">
					The rules have been applied on the device.
				</div>
			}
			if applied == "fail" {
				<div class="bg-red-500/20 border border-red-500 text-red-400 px-4 py-3 rounded">
					The device did not respond. Rules are saved but not applied.
				</div>
			}
			if applied == "invalid" {
				<div class="bg-red-500/20 border border-red-500 text-red-400 px-4 py-3 rounded">
					Invalid rule. Check direction, protocol and ports.
				</div>
			}
			if powerNotice == "ok" {
				<div class="bg-green-500/20 border border-green-500 text-green-400 px-4 py-3 rounded">
					Power command sent.
				</div>
			}
			if powerNotice == "fail" {
				<div class="bg-red-500/20 border border-red-500 text-red-400 px-4 py-3 rounded">
					The device did not respond to the power command.
				</div>
			}
			<!-- Power -->
			<div class="bg-gray-800 border border-gray-700 rounded-2xl p-6">
				<h2 class="flex items-center gap-2 text-xl font-semibold text-white mb-4">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
						<path d="M18.36 6.64a9 9 0 1 1-12.72 0"></path>
						<path d="M12 2v10"></path>
					</svg>
					Power
				</h2>
				<div class="flex flex-wrap gap-3">
					<form method="POST" action={ "/devices/" + strconv.FormatUint(uint64(device.ID), 10) + "/power" }>
						<input type="hidden" name="action" value="reboot"/>
						<button type="submit" class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg text-sm transition-all duration-200">
							Reboot
						</button>
					</form>
					<form method="POST" action={ "/devices/" + strconv.FormatUint(uint64(device.ID), 10) + "/power" }>
						<input type="hidden" name="action" value="shutdown"/>
						<button type="submit" class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg text-sm transition-all duration-200">
							Shut down
						</button>
					</form>
					<form method="POST" action={ "/devices/" + strconv.FormatUint(uint64(device.ID), 10) + "/power" }>
						<input type="hidden" name="action" value="wakeup"/>
						<button type="submit" class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg text-sm transition-all duration-200">
							Wake up
						</button>
					</form>
				</div>
				<p class="text-gray-500 text-sm mt-3">Reboot takes the device offline for a few seconds. A shut down device stays offline until woken up.</p>
			</div>
			<!-- Console -->
			<div class="bg-gray-800 border border-gray-700 rounded-2xl p-6">
				<h2 class="flex items-center gap-2 text-xl font-semibold text-white mb-4">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
						<path d="m4 17 6-6-6-6M12 19h8"></path>
					</svg>
					Console
				</h2>
				if consoleOut != "" {
					<pre class="bg-black/60 border border-gray-700 rounded-xl p-4 text-sm text-green-300 font-mono whitespace-pre-wrap mb-4">{ consoleOut }</pre>
				}
				<form method="POST" action={ "/devices/" + strconv.FormatUint(uint64(device.ID), 10) + "/console" } class="flex flex-col md:flex-row gap-4">
					<input
						type="text"
						name="command"
						placeholder="Type help and press Run"
						required=""
						autocomplete="off"
						class="flex-1 px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 font-mono focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
					/>
					<button
						type="submit"
						class="px-6 py-3 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold rounded-lg transition-all duration-200"
					>
						Run
					</button>
				</form>
			</div>
			<!-- Firewall -->
			<div class="bg-gray-800 border border-gray-700 rounded-2xl p-6">
				<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
					<h2 class="flex items-center gap-2 text-xl font-semibold text-white">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
						</svg>
						Firewall rules
					</h2>
					<form method="POST" action={ "/devices/" + strconv.FormatUint(uint64(device.ID), 10) + "/firewall/apply" }>
						<button
							type="submit"
							class="px-4 py-2 bg-secondary hover:bg-amber-300 text-gray-900 font-semibold rounded-lg text-sm transition-all duration-200"
						>
							Apply to device
						</button>
					</form>
				</div>
				if len(rules) == 0 {
					<p class="text-gray-400 mb-4">No rules for this device.</p>
				} else {
					<div class="rounded-xl overflow-x-auto mb-4">
						<table class="w-full text-left min-w-[720px]">
							<thead class="bg-gray-700/50">
								<tr>
									<th class="px-4 py-3 text-gray-300 text-sm font-semibold">Direction</th>
									<th class="px-4 py-3 text-gray-300 text-sm font-semibold">Protocol</th>
									<th class="px-4 py-3 text-gray-300 text-sm font-semibold">Ports</th>
									<th class="px-4 py-3 text-gray-300 text-sm font-semibold">Address</th>
									<th class="px-4 py-3 text-gray-300 text-sm font-semibold">Action</th>
									<th class="px-4 py-3 text-gray-300 text-sm font-semibold">On</th>
									<th class="px-4 py-3"></th>
								</tr>
							</thead>
							<tbody>
								for _, rule := range rules {
									<tr class="border-t border-gray-700">
										<td class="px-4 py-3 text-gray-300">{ rule.Direction }</td>
										<td class="px-4 py-3 text-gray-300">{ rule.Protocol }</td>
										<td class="px-4 py-3 text-gray-300">{ strconv.Itoa(rule.PortFrom) }–{ strconv.Itoa(rule.PortTo) }</td>
										<td class="px-4 py-3 text-gray-300">{ rule.RemoteAddress }</td>
										<td class="px-4 py-3 text-gray-300">{ rule.Action }</td>
										<td class="px-4 py-3">
											<form method="POST" action={ "/devices/" + strconv.FormatUint(uint64(device.ID), 10) + "/firewall/" + strconv.FormatUint(uint64(rule.ID), 10) + "/toggle" }>
												if rule.Enabled {
													<input type="hidden" name="enabled" value="0"/>
													<button type="submit" class="text-green-400 hover:text-green-300 text-sm">on ✓</button>
												} else {
													<input type="hidden" name="enabled" value="1"/>
													<button type="submit" class="text-gray-500 hover:text-gray-300 text-sm">off</button>
												}
											</form>
										</td>
										<td class="px-4 py-3 text-right">
											<form method="POST" action={ "/devices/" + strconv.FormatUint(uint64(device.ID), 10) + "/firewall/" + strconv.FormatUint(uint64(rule.ID), 10) + "/delete" }>
												<button type="submit" class="text-red-400 hover:text-red-300 text-sm">Delete</button>
											</form>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				<form method="POST" action={ "/devices/" + strconv.FormatUint(uint64(device.ID), 10) + "/firewall" } class="grid grid-cols-2 md:grid-cols-7 gap-3">
					<select name="direction" class="px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white text-sm">
						<option value="inbound">inbound</option>
						<option value="outbound">outbound</option>
					</select>
					<select name="protocol" class="px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white text-sm">
						<option value="tcp">TCP</option>
						<option value="udp">UDP</option>
					</select>
					<input type="number" name="port_from" placeholder="From port" min="1" max="65535" required="" class="px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white text-sm"/>
					<input type="number" name="port_to" placeholder="To port" min="1" max="65535" required="" class="px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white text-sm"/>
					<input type="text" name="remote_address" placeholder="Address (optional)" class="px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 text-sm"/>
					<select name="action" class="px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-white text-sm">
						<option value="allow">allow</option>
						<option value="deny">deny</option>
					</select>
					<button type="submit" class="col-span-2 md:col-span-1 px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm transition-all duration-200">
						Add
					</button>
				</form>
			</div>
			<!-- Update tasks -->
			<div class="bg-gray-800 border border-gray-700 rounded-2xl p-6">
				<h2 class="flex items-center gap-2 text-xl font-semibold text-white mb-4">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
						<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
						<path d="M3.3 7 12 12l8.7-5M12 22V12"></path>
					</svg>
					Update tasks
				</h2>
				if len(tasks) == 0 {
					<p class="text-gray-400">No tasks for this device.</p>
				} else {
					<div class="rounded-xl overflow-x-auto">
						<table class="w-full text-left min-w-[560px]">
							<thead class="bg-gray-700/50">
								<tr>
									<th class="px-4 py-3 text-gray-300 text-sm font-semibold">Package</th>
									<th class="px-4 py-3 text-gray-300 text-sm font-semibold">Version</th>
									<th class="px-4 py-3 text-gray-300 text-sm font-semibold">Status</th>
								</tr>
							</thead>
							<tbody>
								for _, task := range tasks {
									<tr class="border-t border-gray-700">
										<td class="px-4 py-3 text-white">{ task.PackageName }</td>
										<td class="px-4 py-3 text-gray-300">{ task.PackageVersion }</td>
										<td class="px-4 py-3 text-gray-300">{ task.Status }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	</div>
}
