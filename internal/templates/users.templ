package templates

import (
	"goth/internal/store"
	"strconv"
)

templ Users(users []store.User, currentEmail string) {
	<div class="min-h-screen bg-gray-900">
		<div class="bg-gradient-to-r from-gray-800 to-gray-900 shadow-xl">
			<div class="max-w-7xl mx-auto px-4 py-8">
				<a href="/admin" class="text-gray-400 hover:text-secondary transition-colors text-sm">← Admin</a>
				<h1 class="text-4xl font-bold text-white mt-2 mb-2">Users</h1>
				<p class="text-gray-400">Grant and revoke admin access</p>
			</div>
		</div>
		<div class="max-w-7xl mx-auto px-4 py-8">
			if len(users) == 0 {
				<p class="text-gray-400">No users yet.</p>
			} else {
				<div class="bg-gray-800 rounded-2xl shadow-lg overflow-x-auto">
					<table class="w-full text-left min-w-[560px]">
						<thead class="bg-gray-700/50">
							<tr>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Email</th>
								<th class="px-6 py-4 text-gray-300 text-sm font-semibold">Role</th>
								<th class="px-6 py-4"></th>
							</tr>
						</thead>
						<tbody>
							for _, user := range users {
								<tr class="border-t border-gray-700">
									<td class="px-6 py-4 text-white font-medium">{ user.Email }</td>
									<td class="px-6 py-4">
										if user.IsAdmin {
											<span class="text-green-400 font-medium">Admin</span>
										} else {
											<span class="text-gray-400">User</span>
										}
									</td>
									<td class="px-6 py-4 text-right">
										if user.Email != currentEmail {
											if user.IsAdmin {
												<form method="POST" action={ "/admin/users/" + strconv.FormatUint(uint64(user.ID), 10) + "/revoke" }>
													<button type="submit" class="px-4 py-2 bg-red-600/20 border border-red-500 text-red-400 rounded-lg hover:bg-red-600/40 transition-all duration-200">
														Revoke admin
													</button>
												</form>
											} else {
												<form method="POST" action={ "/admin/users/" + strconv.FormatUint(uint64(user.ID), 10) + "/grant" }>
													<button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all duration-200">
														Make admin
													</button>
												</form>
											}
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}
